+// ── v3.3.2 (Stage 2): Qualitätsindex Q ──────────────────────────────────
+// Weiche Rampe 1→0 auf Smoothstep-Basis: 1 bei x<=x0, 0 bei x>=x1, dazwischen
+// stetig differenzierbar (keine harten Sprünge in der Anzeige). x1<x0 kehrt
+// die Rampe um ("mehr ist besser", z.B. Signalpegel).
+function ramp01(x,x0,x1){
+  if(x0===x1) return x<=x0?1:0;
+  const t=(x-x0)/(x1-x0);
+  if(t<=0) return 1;
+  if(t>=1) return 0;
+  return 1-t*t*(3-2*t);
+}
+
+// Zeitlicher Variationskoeffizient über einen Ringpuffer (yMean_lin der
+// letzten Frames). Unter 5 Samples keine Aussage -> null (neutral).
+class TemporalStats {
+  constructor(n=30){this.n=n;this.buf=[];}
+  push(v){this.buf.push(v);if(this.buf.length>this.n)this.buf.shift();}
+  cv(){
+    if(this.buf.length<5) return null;
+    const m=this.buf.reduce((a,b)=>a+b,0)/this.buf.length;
+    if(m===0) return null;
+    const va=this.buf.reduce((s,v)=>s+(v-m)**2,0)/this.buf.length;
+    return Math.sqrt(va)/m;
+  }
+  reset(){this.buf=[];}
+}
+
+// Q = Produkt vier normierter Komponenten in [0,1]. Produkt statt Minimum:
+// mehrere mittlere Probleme drücken Q stärker als ein einzelnes - entspricht
+// der realen Verlässlichkeit. null-Komponenten (keine Aussage möglich) gehen
+// neutral mit 1 ein statt doppelt zu bestrafen.
+const Q_CLIP_FULL=0.01,Q_CLIP_ZERO=0.15;   // Clipping-Anteil (0.15 = 'critical'-Schwelle)
+const Q_UNI_FULL=0.05,Q_UNI_ZERO=0.50;     // räumlicher CV der 3x3-Zonen
+const Q_STAB_FULL=0.01,Q_STAB_ZERO=0.25;   // zeitlicher CV
+const SIGNAL_FULL_LIN=0.04;                // ab hier volles Signal-Q (invertierte Rampe bis SIGNAL_CRIT_LIN)
+function computeQuality({clipRatio,uniformityCV,yMeanLin,temporalCV}){
+  const qClip=ramp01(clipRatio,Q_CLIP_FULL,Q_CLIP_ZERO);
+  const qUniformity=uniformityCV==null?1:ramp01(uniformityCV,Q_UNI_FULL,Q_UNI_ZERO);
+  const qSignal=ramp01(yMeanLin,SIGNAL_FULL_LIN,SIGNAL_CRIT_LIN);
+  const qStability=temporalCV==null?1:ramp01(temporalCV,Q_STAB_FULL,Q_STAB_ZERO);
