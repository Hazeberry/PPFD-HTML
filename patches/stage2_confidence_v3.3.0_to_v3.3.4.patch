+const Q_UNI_FULL=0.05,Q_UNI_ZERO=0.40;      // räumlicher CV (5% -> 40%)
+const Q_STAB_FULL=0.02,Q_STAB_ZERO=0.25;    // zeitlicher CV (2% -> 25%)
