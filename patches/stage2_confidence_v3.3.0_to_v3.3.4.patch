+// Verbraucher (Stage-2-Design): Q_stability hier, u_temporal in der
+// Unsicherheitsabschätzung (nächster Schritt) liest denselben CV.
+class TemporalStats{
+  constructor(n=30){this.n=n;this.buf=[];}
+  push(v){this.buf.push(v);if(this.buf.length>this.n)this.buf.shift();}
+  cv(){
+    const m=this.buf.length;
+    if(m<5) return null; // zu wenig Daten -> neutral, kein falscher Alarm
+    const mean=this.buf.reduce((a,b)=>a+b,0)/m;
+    if(mean<SIGNAL_CRIT_LIN) return null; // Rauschdomäne -> Q_signal übernimmt
+    let acc=0;
+    for(const v of this.buf){const d=v-mean;acc+=d*d;}
+    return Math.sqrt(acc/m)/mean;
+  }
